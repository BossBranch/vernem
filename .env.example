# Скопируйте в .env и заполните. Файл .env НЕ коммитить.

# Токен бота. Без него работает только веб-часть (мини-приложение в демо-режиме и /health).
MAX_BOT_TOKEN=
# Ник бота без @ (необязательно: берётся из API при старте)
BOT_USERNAME=

# Публичный HTTPS-адрес сервера. Если задан — бот работает через webhook, иначе через long polling.
PUBLIC_URL=
# Домен для Caddy (профиль https), например vernem.example.ru — без https://
DOMAIN=
# polling | webhook (по умолчанию: webhook при заданном PUBLIC_URL)
BOT_MODE=
# Секрет webhook (по умолчанию выводится из токена)
WEBHOOK_SECRET=

# Мини-приложение (нужен PUBLIC_URL и подключение мини-приложения к боту: для бота хакатона — через организаторов)
MINIAPP_ENABLED=false
# Разрешить вход в мини-приложение без MAX по заголовку X-Demo-User (только для локальной проверки!)
ALLOW_DEMO_AUTH=false

# Кнопка «🧪 Демо» в меню бота
DEMO_MODE=true
# Ускоренные напоминания для проверки: «восстановили?» через 2 мин, «перерасчёт пришёл?» через 3 мин
FAST_REMINDERS=false
RESTORE_CHECK_HOURS=3
RECEIPT_CHECK_DAYS=30

DEFAULT_TZ=Europe/Moscow
HOST_PORT=3000
# ID администраторов MAX через запятую — им доступна команда /stats (воронка)
ADMIN_IDS=

# Общество защиты прав потребителей, которому житель может передать дело.
# Пусто — партнёр не подключён: бот говорит об этом и готовит заявление для любого такого общества.
PARTNER_ORG_NAME=
# Сайт или форма приёма обращений партнёра, только https://
PARTNER_ORG_URL=
